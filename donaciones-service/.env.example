# Ejemplo de `.env` para correr donaciones-service fuera de Docker.
# Copialo a `.env` (mismo directorio) y completá la contraseña. `.env` está en .gitignore.

SERVER_PORT=8084

DB_URL=jdbc:mysql://localhost:3306/donaciones_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=valentin
DB_PASSWORD=

RABBITMQ_HOST=autorack.proxy.rlwy.net
RABBITMQ_PORT=30014
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

NOTIFICACIONES_URL=http://localhost:8083/api
INCENTIVOS_URL=http://localhost:8082
LOGISTICAS_URL=http://localhost:8086/api
