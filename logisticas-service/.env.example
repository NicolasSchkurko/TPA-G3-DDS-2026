# Ejemplo de `.env` para correr logisticas-service fuera de Docker.
# Copialo a `.env` (mismo directorio) y completá la contraseña. `.env` está en .gitignore.
# OJO: este servicio NO tiene defaults para DB_USERNAME/DB_PASSWORD.
# Sin esas dos variables, no arranca.

SERVER_PORT=8086

DB_URL=jdbc:mysql://localhost:3306/logisticas?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=valentin
DB_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
