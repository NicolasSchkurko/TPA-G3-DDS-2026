# Ejemplo de `.env` para correr front-service fuera de Docker.
# Copialo a `.env` (mismo directorio); `.env` está en .gitignore.
# El front no tiene ACL de servicios: es la puerta de entrada de usuarios.

SERVER_PORT=8081
DONACIONES_URL=http://localhost:8084
INCENTIVOS_URL=http://localhost:8082
NOTIFICACIONES_URL=http://localhost:8083/api
LOGISTICAS_URL=http://localhost:8086/api

# Keycloak (valores de desarrollo; cambiar en entornos compartidos).
KEYCLOAK_CLIENT_ID=front-service
KEYCLOAK_CLIENT_SECRET=front-service-dev-secret
KEYCLOAK_REALM=ddsi
KEYCLOAK_ADMIN_BASE_URI=http://localhost:8180/admin
KEYCLOAK_REGISTRATION_CLIENT_ID=front-registration
KEYCLOAK_REGISTRATION_CLIENT_SECRET=front-registration-dev-secret
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ddsi
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8180/realms/ddsi/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://localhost:8180/realms/ddsi/protocol/openid-connect/token
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/ddsi/protocol/openid-connect/certs
KEYCLOAK_USER_INFO_URI=http://localhost:8180/realms/ddsi/protocol/openid-connect/userinfo
KEYCLOAK_LOGOUT_URI=http://localhost:8180/realms/ddsi/protocol/openid-connect/logout
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/

# Alojamiento externo de imágenes (catbox.moe no requiere API key).
IMAGENES_UPLOAD_URL=https://catbox.moe/user/api.php
