                                                    }
                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\n  \"canal\": \"email\",\n  \"direccionContacto\": \"ana@test.com\",\n  \"mensaje\": {\n    \"asunto\": \"Prueba desde Postman\",\n    \"cuerpo\": \"Hola Ana, esta es una prueba del webhook de notificaciones.\"\n  }\n}"
                                              },
                                     "url":  {
                                                 "raw":  "{{n8nUrl}}/webhook/notificaciones",
                                                 "host":  [
                                                              "{{n8nUrl}}"
                                                          ],
                                                 "path":  [
                                                              "webhook",
                                                              "notificaciones"
                                                          ]
                                             },
                                     "description":  "Payload = NotificacionPayload de notificaciones-service. El workflow hace switch por body.canal: email | whatsapp | telefono."
                                 }
                 },
