              "raw": "{{baseUrl}}/api/rankings/actual",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rankings", "actual"]
            },
            "description": "Sustituye al GET /perfiles/:id/ranking que tenia la version anterior y no existia."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('devuelve el ranking del mes (o 404 si no hay ranking cerrado)', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
