{
  "info": {
    "_postman_id": "6d385e23-9ff1-4c4a-a25e-a99fb5fad606",
    "name": "servicio incentivos",
    "description": "Referencia de la API de incentivos, verificada contra los controllers.\n\n**Corregida:** la version anterior tenia cinco URLs que no existen, heredadas de una version anterior de la API:\n\n| estaba | es |\n|---|---|\n| `POST /perfiles` | `POST /api/perfiles` (los paths ya traen /api) |\n| `PUT /perfiles/:id` | `PUT /api/perfiles/{idUsuario}` |\n| `GET /perfiles/:id/ranking/top3` | `GET /api/rankings/{id}/top` |\n| `GET /perfiles/:id/ranking` | `GET /api/rankings/actual` |\n| `GET /perfiles/:id/metricas` | `GET /api/metricas/{idUsuario}/actividad` |\n| `GET /perfiles/:id/comparativa` | no existe: se saco |\n\nLas de metricas cambian de raiz: el controller de metricas esta en `/api/metricas`, no cuelga de perfiles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "48547069"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082", "description": "Puerto real de incentivos-service" },
    { "key": "idUsuario", "value": "123e4567-e89b-12d3-a456-426614174000", "description": "UUID del usuario asociado al perfil" },
    { "key": "idRanking", "value": "123e4567-e89b-12d3-a456-426614174001" }
  ],
  "item": [
    {
      "name": "Perfiles",
      "item": [
        {
          "name": "Crear un nuevo perfil de donante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idUsuario\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"nombreUsuario\": \"Juan Perez\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/perfiles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles"]
            },
            "description": "Lo llama donaciones-service cuando se da de alta un donante. Conviene correrlo sobre una base limpia: un perfil que ya existe se rechaza."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('el perfil se creo', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Consultar un perfil por el id del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/:idUsuario",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", ":idUsuario"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}", "description": "UUID del usuario asociado al perfil" } ]
            },
            "description": "El id es el del USUARIO, no el del perfil. Es el mismo id que dona donating al crear el perfil."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('devuelve el perfil o un 404 si no existe', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Obtener la mision actual asignada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/:idUsuario/mision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", ":idUsuario", "mision"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}", "description": "UUID del usuario asociado al perfil" } ]
            },
            "description": "Devuelve el objetivo gamificado vigente (racha, completitud) del perfil."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('devuelve la mision o un 404', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Listar insignias obtenidas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/:idUsuario/insignias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", ":idUsuario", "insignias"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}" } ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('devuelve las insignias o un 404', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Ver el perfil publico del donante",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/:idUsuario/publico",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", ":idUsuario", "publico"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}" } ]
            },
            "description": "Es lo que se muestra al donante en el front."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('devuelve el perfil publico o un 404', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Registrar el impacto de una donacion (lo llama donating)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idDonacion\": \"123e4567-e89b-12d3-a456-426614174002\",\n  \"fechaEntrega\": \"2026-10-07T10:00:00\",\n  \"cantidadBienes\": 10,\n  \"subCategoria\": \"ENLATADOS\",\n  \"categoria\": \"ALIMENTOS\",\n  \"entidadBeneficiaria\": \"Banco de alimentos\",\n  \"estado\": \"ENTREGADA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/donacion/:idUsuario",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", "donacion", ":idUsuario"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}" } ]
            },
            "description": "Es el endpoint que llama donaciones-service cuando asigna una donacion (IncentivosClient.notificarDonacionAsignada). Es la conexion donating -> incentivos del enunciado."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('el perfil acepta el impacto o rechaza el usuario inexistente', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Actualizar un perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"Juan Perez actualizado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/:idUsuario",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", ":idUsuario"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}" } ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('actualiza o rechaza si no existe', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Eliminar un perfil",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfiles/:idUsuario",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfiles", ":idUsuario"],
              "variable": [ { "key": "idUsuario", "value": "{{idUsuario}}" } ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('borra o rechaza si no existe', function () {",
                "    pm.expect(pm.response.code).to.be.oneOf([200, 204, 404]);",
                "});"
              ] }
            }
          ]
        }
      ]
    },
    {
