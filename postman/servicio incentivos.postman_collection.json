              "host": ["{{baseUrl}}"],
              "path": ["api", "rankings", ":id", "top"],
              "variable": [ { "key": "id", "value": "{{idRanking}}" } ],
              "query": [ { "key": "cantidad", "value": "3" } ]
            },
            "description": "Sustituye al GET /perfiles/:id/ranking/top3. Es el mismo recurso, pero el top esta en el controller de rankings, no en el de perfiles."
