    {
      "name": "Rankings",
      "description": "Cuelga de /api/rankings. El ranking general del mes corriente es /actual, y el top es /{id}/top con un query param de cantidad.",
      "item": [
        {
          "name": "Consultar el ranking general del mes corriente",
          "request": {
            "method": "GET",
            "header": [],
