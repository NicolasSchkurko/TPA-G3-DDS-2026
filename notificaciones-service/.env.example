# Ejemplo de `.env` para correr notificaciones-service fuera de Docker.
# Copialo a `.env` (mismo directorio) y completá la contraseña. `.env` está en .gitignore.

SERVER_PORT=8083

DB_URL=jdbc:mysql://localhost:3306/notificaciones?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=marcelo
DB_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

N8N_URL=http://localhost:5678/webhook/notificaciones
N8N_CONNECT_TIMEOUT_MS=5000
N8N_READ_TIMEOUT_MS=10000
