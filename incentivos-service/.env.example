# Ejemplo de `.env` para correr incentivos-service fuera de Docker.
# Copialo a `.env` (mismo directorio). `.env` está en .gitignore.
# Se exportan antes de `mvn spring-boot:run` (direnv, dotenv o el plugin del IDE).

SERVER_PORT=8082

DB_URL=jdbc:mysql://localhost:3306/incentivos_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=incentivos_user
DB_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

DONACIONES_URL=http://localhost:8084
NOTIFICACIONES_URL=http://localhost:8083/api
N8N_URL=http://localhost:5678/webhook/incentivos
