# Variables de entorno para correr incentivos-service fuera de Docker.
# Spring Boot no las carga solo: se exportan antes de `mvn spring-boot:run`
# (por ejemplo con `direnv`, `dotenv` o el plugin de dotenv).

# URL base del servicio de donaciones (sin sufijo de endpoint).
DONACIONES_URL=http://localhost:8084

# URL base del servicio de notificaciones.
NOTIFICACIONES_URL=http://localhost:8083/

# Webhook de n8n que genera la publicacion de la insignia en redes.
N8N_URL=http://localhost:5678/webhook/incentivos