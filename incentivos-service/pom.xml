<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ar.edu.utn.frba.ddsi</groupId>
        <artifactId>ddsi-tp-template</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>incentivos-service</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                NO hay plugin de Checkstyle aca a proposito. Se probo y rompe `mvn verify`
                en una maquina sin internet: el plugin necesita descargar (ademas del
                maven-reporting, del doxia y del plexus) el artifact com.puppycrawl:checkstyle
                y las dependencias de reporting, y ninguna esta en el .m2 local. Un build que
                falla por una dependencia que no se puede bajar es peor que un build que no
                valida estilo.

                La validacion corre por `run-checkstyle.ps1` en la raiz del repo, que usa el
                jar de Checkstyle que ya trae el plugin de IntelliJ. Para meterla al build de
                verdad hace falta una maquina con acceso a Maven Central: ver el punto 37 de
                PENDIENTES.md, que tiene el XML listo para pegar.
            -->
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <!--
            RabbitMQ. El enunciado exige que la integracion con notificaciones sea asincrona
            "a traves de una cola de mensajes", y sin esta dependencia no hay RabbitTemplate ni
            forma de publicar. Antes el servicio mandaba las notificaciones por HTTP
            sincronico, que es justo lo contrario de lo pedido.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--
            Spring Security, declarado aca a proposito y no heredado del padre.

            El padre lo saca porque lo heredaban los cuatro modulos y en los otros tres no hay
            ninguna clase de seguridad: Spring Boot generaba una password aleatoria y
            bloqueaba todo. En notificaciones eso era 401 en POST /notificaciones, con lo que
            ningun servicio de dominio podia publicar un aviso.

            Incentivos lo declara para poder dejar la politica de acceso escrita y explicita en
            su SecurityConfig, aunque hoy sea dejar pasar todo. Es el lugar donde reintroducir
            una politica real si alguna vez se define, y tenerlo declarado evita depender del
            comportamiento por defecto de Boot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

</project>
